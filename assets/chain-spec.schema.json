{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCBE Command Block Chain Spec",
  "description": "Declarative description of a Bedrock Edition command-block chain. Use with scripts/chain_lint.py.",
  "type": "object",
  "required": ["name", "blocks"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "description": "Stable id, used in the build plan."
    },
    "description": {
      "type": "string",
      "description": "One paragraph: what this chain does, trigger, end state."
    },
    "target_version": {
      "type": "string",
      "description": "Tested Bedrock version, e.g. 1.21.0."
    },
    "setup": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Commands to run once before building (objectives, constants, gamerules)."
    },
    "tests": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Manual test checklist."
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Design notes, assumptions, version caveats."
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/block" }
    }
  },
  "definitions": {
    "block": {
      "type": "object",
      "required": ["id", "type", "command"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "type": {
          "enum": ["impulse", "repeat", "chain"]
        },
        "condition": {
          "enum": ["unconditional", "conditional"],
          "default": "unconditional"
        },
        "redstone": {
          "enum": ["always_active", "needs_redstone"],
          "description": "Default: chain=always_active, impulse/repeat=needs_redstone."
        },
        "delay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Delay in ticks. Impulse/repeat: 0 == 1; chain: 0 == same tick."
        },
        "execute_first_tick": {
          "type": "boolean",
          "description": "Repeat only. Default true."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32500,
          "description": "Bedrock command without the leading slash."
        },
        "next": {
          "type": ["string", "null"],
          "description": "Id of the next chain block, or null/omitted for terminal."
        },
        "pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Optional block position [x, y, z] for layout checks."
        },
        "facing": {
          "enum": ["north", "south", "east", "west", "up", "down"],
          "description": "Optional facing direction; checked against pos deltas when provided."
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
